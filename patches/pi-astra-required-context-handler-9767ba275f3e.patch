+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { zstdDecompressSync } from "node:zlib";
+import { InMemoryCredentialStore } from "@earendil-works/pi-ai";
+import { afterEach, describe, expect, test, vi } from "vitest";
+import type { AgentSession, InlineExtension } from "../src/index.ts";
+import {
+	createAgentSession,
+	DefaultResourceLoader,
+	ModelRuntime,
+	SessionManager,
+	SettingsManager,
+} from "../src/index.ts";
+
+const extensionPath = process.env.ASTRA_EXTENSION_PATH;
+const RESPONSES_URL = "https://chatgpt.com/backend-api/codex/responses";
+const ACCOUNT_ID = "astra-recovery-test-account";
+const PNG = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=";
+const directories: string[] = [];
+const sessions: AgentSession[] = [];
+
+interface CapturedRequest {
+	readonly url: string;
+	readonly headers: Headers;
+	readonly payload: unknown;
+	readonly signal: AbortSignal | null | undefined;
+}
+
+type Reply = (request: CapturedRequest) => Response | Promise<Response>;
+
+function createGate(): { readonly promise: Promise<void>; readonly resolve: () => void } {
+	let release: (() => void) | undefined;
+	const promise = new Promise<void>((resolve) => {
+		release = resolve;
+	});
+	assert(release);
+	return { promise, resolve: release };
+}
+
+interface ControlledWebSocket {
+	readonly headers: Readonly<Record<string, string>>;
+	open(): void;
+	complete(responseId: string): void;
+}
+
+function createControlledWebSockets(onConnection?: (socket: ControlledWebSocket) => void): {
+	readonly WebSocket: {
+		readonly OPEN: number;
+		new (url: string, protocols?: string | string[] | { headers?: Record<string, string> }): ControlledWebSocket;
+	};
+	readonly connections: ControlledWebSocket[];
+	readonly sends: () => number;
+	readonly closes: () => number;
+} {
+	const connections: ControlledWebSocket[] = [];
+	let sends = 0;
+	let closes = 0;
+	class MockWebSocket implements ControlledWebSocket {
+		static OPEN = 1;
+		readyState = MockWebSocket.OPEN;
+		readonly headers: Readonly<Record<string, string>>;
+		private listeners = new Map<string, Set<(event: unknown) => void>>();
+
+		constructor(_url: string, protocols?: string | string[] | { headers?: Record<string, string> }) {
+			this.headers =
+				protocols && typeof protocols === "object" && !Array.isArray(protocols) ? (protocols.headers ?? {}) : {};
+			connections.push(this);
+			onConnection?.(this);
+		}
+
+		addEventListener(type: string, listener: (event: unknown) => void): void {
+			let listeners = this.listeners.get(type);
+			if (!listeners) {
+				listeners = new Set();
+				this.listeners.set(type, listeners);
+			}
+			listeners.add(listener);
+		}
+
+		removeEventListener(type: string, listener: (event: unknown) => void): void {
+			this.listeners.get(type)?.delete(listener);
+		}
+
+		send(): void {
+			sends++;
+			queueMicrotask(() => this.complete("controlled-websocket-response"));
+		}
+
+		close(): void {
+			closes++;
+			this.readyState = 3;
+		}
+
+		open(): void {
+			this.dispatch("open", {});
+		}
+
+		complete(responseId: string): void {
+			this.dispatch("message", {
+				data: JSON.stringify({
+					type: "response.completed",
+					response: {
+						id: responseId,
+						status: "completed",
+						usage: { input_tokens: 1, output_tokens: 1, total_tokens: 2 },
+					},
+				}),
+			});
+		}
+
+		private dispatch(type: string, event: unknown): void {
+			for (const listener of this.listeners.get(type) ?? []) listener(event);
+		}
+	}
+	return { WebSocket: MockWebSocket, connections, sends: () => sends, closes: () => closes };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function inputItems(request: CapturedRequest): Record<string, unknown>[] {
+	assert(isRecord(request.payload));
+	assert(Array.isArray(request.payload.input));
+	assert(request.payload.input.every(isRecord));
+	return request.payload.input;
+}
+
+function sse(items: readonly Record<string, unknown>[]): Response {
+	const events: Record<string, unknown>[] = [];
+	for (const [outputIndex, item] of items.entries()) {
+		events.push({ type: "response.output_item.added", output_index: outputIndex, item });
+		if (item.type === "function_call") {
+			events.push({ type: "response.function_call_arguments.done", arguments: item.arguments });
+		}
+		events.push({ type: "response.output_item.done", output_index: outputIndex, item });
+	}
+	events.push({
+		type: "response.completed",
+		response: {
+			status: "completed",
+			usage: { input_tokens: 10, output_tokens: 2, total_tokens: 12, input_tokens_details: { cached_tokens: 0 } },
+		},
+	});
+	return new Response(events.map((event) => `data: ${JSON.stringify(event)}\n\n`).join(""), {
+		headers: { "content-type": "text/event-stream" },
+	});
+}
+
+function textResponse(): Response {
+	return sse([
+		{
+			type: "message",
+			id: "recovered-message",
+			role: "assistant",
+			status: "completed",
+			content: [{ type: "output_text", text: "recovered task" }],
+		},
+	]);
+}
+
+function toolCall(
+	id: string,
+	name: string,
+	arguments_: Record<string, unknown>,
+	namespace?: string,
+): Record<string, unknown> {
+	return {
+		type: "function_call",
+		id: `fc_${id}`,
+		call_id: id,
+		name,
+		arguments: JSON.stringify(arguments_),
+		...(namespace ? { namespace } : {}),
+	};
+}
+
+async function fixture(
