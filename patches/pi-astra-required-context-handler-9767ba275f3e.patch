+import { fauxAssistantMessage, fauxProvider, InMemoryCredentialStore } from "@earendil-works/pi-ai";
+import { expect, test } from "vitest";
+import {
+	getRequiredContextHandler,
+	REQUIRED_CONTEXT_HANDLER_ENTRY_TYPE,
+} from "../src/core/context-handler-requirement.ts";
+import {
+	createAgentSession,
+	DefaultResourceLoader,
+	ModelRuntime,
+	SessionManager,
+	SettingsManager,
+} from "../src/index.ts";
+
+const requiredState = { protocol: 1, handler: "astra-remote", version: 1 };
+
+test.each(["throws", "replaces context"] as const)(
+	"fails closed when a registered required context hook %s",
+	async (behavior) => {
+		const sessionManager = SessionManager.inMemory("/required-handler-test");
+		const settingsManager = SettingsManager.inMemory({
+			retry: { enabled: false, maxRetries: 0, baseDelayMs: 0 },
+		});
+		const modelRuntime = await ModelRuntime.create({
+			credentials: new InMemoryCredentialStore(),
+			modelsPath: null,
+			refreshOnCreate: false,
+		});
+		let contextCalls = 0;
+		const provider = fauxProvider({
+			api: "required-handler-api",
+			provider: "required-handler-provider",
+			models: [{ id: "required-handler-model", contextWindow: 32_000, maxTokens: 1_000 }],
+		});
+		provider.setResponses([fauxAssistantMessage("first response")]);
+		modelRuntime.registerNativeProvider(provider.provider);
+
+		const protectedLoader = new DefaultResourceLoader({
+			cwd: "/required-handler-test",
+			agentDir: "/virtual/required-handler-test",
+			settingsManager,
+			noExtensions: true,
+			noSkills: true,
+			noPromptTemplates: true,
+			noThemes: true,
+			noContextFiles: true,
+			systemPrompt: "test",
+			appendSystemPrompt: [],
+			extensionFactories: [
+				{
+					name: "astra-remote",
+					factory: (pi) => {
+						pi.registerContextHandler("astra-remote", 1, undefined, undefined, (messages) => {
+							if (messages.length === 0) throw new Error("simulated final projection mutation");
+						});
+						pi.on("session_start", () => {
+							pi.appendEntry(REQUIRED_CONTEXT_HANDLER_ENTRY_TYPE, requiredState);
+						});
+						pi.on("context", () => {
+							contextCalls += 1;
+						});
+					},
+				},
+				{
+					name: "late-mutator",
+					factory: (pi) => {
+						pi.on("context", () => {
+							if (behavior === "throws") throw new Error("simulated final projection mutation");
+							return { messages: [] };
+						});
+					},
+				},
+			],
+		});
+		await protectedLoader.reload();
+
+		const { session: protectedSession } = await createAgentSession({
+			cwd: "/required-handler-test",
+			agentDir: "/virtual/required-handler-test",
+			model: provider.getModel(),
+			thinkingLevel: "off",
+			modelRuntime,
+			resourceLoader: protectedLoader,
+			sessionManager,
+			settingsManager,
+			noTools: "all",
+		});
+
+		try {
+			await protectedSession.bindExtensions({});
+			expect(
+				sessionManager
+					.getEntries()
+					.some((entry) => entry.type === "custom" && entry.customType === REQUIRED_CONTEXT_HANDLER_ENTRY_TYPE),
+			).toBe(true);
+			expect(getRequiredContextHandler(sessionManager.getEntries())).toEqual({
+				handler: "astra-remote",
+				version: 1,
+			});
+			await protectedSession.prompt("first request");
+			expect(contextCalls).toBe(1);
+			expect(provider.state.callCount).toBe(0);
+			expect(protectedSession.state.messages.at(-1)).toMatchObject({
+				role: "assistant",
+				stopReason: "error",
+				errorMessage: expect.stringContaining("simulated final projection mutation"),
+			});
+			protectedSession.dispose();
+
+			const unprotectedLoader = new DefaultResourceLoader({
+				cwd: "/required-handler-test",
+				agentDir: "/virtual/required-handler-test",
+				settingsManager,
+				noExtensions: true,
+				noSkills: true,
+				noPromptTemplates: true,
+				noThemes: true,
+				noContextFiles: true,
+				systemPrompt: "test",
+				appendSystemPrompt: [],
+			});
+			await unprotectedLoader.reload();
+			const { session: unprotectedSession } = await createAgentSession({
+				cwd: "/required-handler-test",
+				agentDir: "/virtual/required-handler-test",
+				model: provider.getModel(),
+				thinkingLevel: "off",
+				modelRuntime,
+				resourceLoader: unprotectedLoader,
+				sessionManager,
+				settingsManager,
+				noTools: "all",
+			});
+			try {
+				await unprotectedSession.bindExtensions({});
+				unprotectedSession.agent.streamFunction = async () => {
+					throw new Error("unguarded stream should not run");
+				};
+				await expect(unprotectedSession.prompt("second request")).rejects.toThrow(
+					'Required context handler "astra-remote" version 1 is not active',
+				);
+				expect(provider.state.callCount).toBe(0);
+			} finally {
+				unprotectedSession.dispose();
+			}
+		} finally {
+			protectedSession.dispose();
+			modelRuntime.unregisterProvider(provider.provider.id);
+		}
+	},
+);
