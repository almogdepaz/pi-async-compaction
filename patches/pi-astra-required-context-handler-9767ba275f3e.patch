+import type { AgentSession } from "../src/index.ts";
+import {
+	createAgentSession,
+	DefaultResourceLoader,
+	ModelRuntime,
+	SessionManager,
+	SettingsManager,
+} from "../src/index.ts";
+
+// This cross-repository test is opt-in; the portable core patch does not bundle the extension.
+const extensionPath = process.env.ASTRA_EXTENSION_PATH;
+const ACCOUNT_ID = "astra-offline-account";
+const SESSION_REQUIREMENT = "pi.required-context-handler";
+
+function completedResponse(): Response {
+	const item = {
+		type: "message",
+		id: "astra-offline-message",
+		role: "assistant",
+		status: "completed",
+		content: [{ type: "output_text", text: "offline response" }],
+	};
+	const events = [
+		{ type: "response.output_item.added", item: { ...item, status: "in_progress", content: [] } },
+		{ type: "response.content_part.added", part: { type: "output_text", text: "" } },
+		{ type: "response.output_text.delta", delta: "offline response" },
+		{ type: "response.output_item.done", item },
+		{
+			type: "response.completed",
+			response: {
+				status: "completed",
+				usage: { input_tokens: 10, output_tokens: 2, total_tokens: 12, input_tokens_details: { cached_tokens: 0 } },
+			},
+		},
+	];
+	return new Response(events.map((event) => `data: ${JSON.stringify(event)}\n\n`).join(""), {
+		headers: { "content-type": "text/event-stream" },
+	});
+}
+
+afterEach(() => {
+	vi.unstubAllGlobals();
+	vi.unstubAllEnvs();
+});
+
+test.skipIf(!extensionPath)(
+	"loads the real Astra extension and sends native Codex window metadata with host OAuth",
+	async () => {
+		if (!extensionPath) throw new Error("ASTRA_EXTENSION_PATH must select the actual extension entrypoint");
+		vi.stubEnv("PI_ASTRA_REMOTE_CONTEXT", undefined);
+		vi.stubEnv("PI_OFFLINE", "1");
+		const directory = await mkdtemp(join(tmpdir(), "astra-patched-host-"));
+		const requests: Array<{ readonly headers: Headers; readonly payload: Record<string, unknown> }> = [];
+		let session: AgentSession | undefined;
+		try {
+			const credentials = new InMemoryCredentialStore();
+			const claims = Buffer.from(
+				JSON.stringify({ "https://api.openai.com/auth": { chatgpt_account_id: ACCOUNT_ID } }),
+			).toString("base64url");
