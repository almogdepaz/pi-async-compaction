new file mode 100644
index 000000000..1460c9051
--- /dev/null
+++ b/packages/coding-agent/test/required-context-handler.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from "vitest";
+import {
+	getRequiredContextHandler,
+	REQUIRED_CONTEXT_HANDLER_ENTRY_TYPE,
+} from "../src/core/context-handler-requirement.ts";
+import type { SessionEntry } from "../src/core/session-manager.ts";
+
+function requirement(data: unknown): SessionEntry {
+	return {
+		type: "custom",
+		customType: REQUIRED_CONTEXT_HANDLER_ENTRY_TYPE,
+		data,
+		id: "requirement",
+		parentId: null,
+		timestamp: new Date(0).toISOString(),
+	};
+}
+
+describe("required context-handler session state", () => {
+	it("accepts one exact persisted requirement", () => {
+		expect(getRequiredContextHandler([requirement({ protocol: 1, handler: "astra-remote", version: 1 })])).toEqual({
+			handler: "astra-remote",
+			version: 1,
+		});
+	});
+
+	it("fails closed for malformed, unsupported, and conflicting requirements", () => {
+		expect(() => getRequiredContextHandler([requirement({ protocol: 2 })])).toThrow(
+			"Malformed required context-handler state",
+		);
+		expect(() =>
+			getRequiredContextHandler([requirement({ protocol: 1, handler: "astra-remote", version: 0 })]),
+		).toThrow("Malformed required context-handler state");
+		expect(() =>
+			getRequiredContextHandler([
+				requirement({ protocol: 1, handler: "astra-remote", version: 1 }),
+				{
+					...requirement({ protocol: 1, handler: "other-handler", version: 1 }),
+					id: "conflict",
+					parentId: "requirement",
+				},
+			]),
+		).toThrow("Conflicting required context-handler state");
+	});
+});
