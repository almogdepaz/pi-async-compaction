+	assert(extensionPath, "ASTRA_EXTENSION_PATH must select the real extension");
+	vi.stubEnv("PI_OFFLINE", "1");
+	vi.stubEnv("PI_ASTRA_REMOTE_CONTEXT", undefined);
+	const cwd = await mkdtemp(join(tmpdir(), "astra-recovery-"));
+	directories.push(cwd);
