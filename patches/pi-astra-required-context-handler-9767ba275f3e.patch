+				type: "oauth",
+				access: `offline.${claims}.signature`,
+				refresh: "offline-refresh-not-used",
+				expires: Date.now() + 3_600_000,
+				accountId: ACCOUNT_ID,
+			}));
+			vi.stubGlobal("fetch", async (input: string | URL | Request, init?: RequestInit): Promise<Response> => {
+				const url = input instanceof Request ? input.url : String(input);
+				if (url !== "https://chatgpt.com/backend-api/codex/responses") {
+					throw new Error(`unexpected offline-test request destination: ${url}`);
+				}
+				const encoded = init?.body;
+				const text =
+					typeof encoded === "string"
+						? encoded
+						: encoded instanceof Uint8Array
+							? zstdDecompressSync(encoded).toString("utf8")
+							: undefined;
+				if (text === undefined) throw new Error("native Codex request did not contain a JSON body");
+				requests.push({
+					headers: new Headers(init?.headers),
+					payload: JSON.parse(text) as Record<string, unknown>,
+				});
+				return completedResponse();
+			});
+			const modelRuntime = await ModelRuntime.create({ credentials, modelsPath: null, refreshOnCreate: false });
+			const model = modelRuntime.getModels("openai-codex").find((candidate) => candidate.id === "gpt-6-astra");
+			if (!model) throw new Error("test setup requires the pinned host's built-in Astra subscription model");
+			const settingsManager = SettingsManager.inMemory({
+				transport: "sse",
+				compaction: { enabled: false, keepRecentTokens: 1 },
+				retry: { enabled: false, maxRetries: 0, baseDelayMs: 0 },
+			});
+			const resourceLoader = new DefaultResourceLoader({
+				cwd: directory,
+				agentDir: join(directory, "agent"),
+				settingsManager,
+				additionalExtensionPaths: [extensionPath],
+				noExtensions: true,
+				noSkills: true,
+				noPromptTemplates: true,
+				noThemes: true,
+				noContextFiles: true,
+				systemPrompt: "Offline Astra integration fixture.",
+				appendSystemPrompt: [],
+			});
+			await resourceLoader.reload();
+			expect(resourceLoader.getExtensions().errors).toEqual([]);
+			const sessionManager = SessionManager.inMemory(directory);
+			({ session } = await createAgentSession({
+				cwd: directory,
+				agentDir: join(directory, "agent"),
+				model,
+				thinkingLevel: "off",
+				modelRuntime,
+				resourceLoader,
+				sessionManager,
+				settingsManager,
+				noTools: "builtin",
+			}));
+			await session.bindExtensions({});
+			expect(
+				sessionManager
+					.getEntries()
+					.some((entry) => entry.type === "custom" && entry.customType === SESSION_REQUIREMENT),
+			).toBe(true);
+			await session.prompt("retain this initial task across remote windows");
+			await session.waitForIdle();
+			expect(requests).toHaveLength(1);
+			const request = requests[0];
+			if (!request) throw new Error("expected the real provider request");
+			expect(request.headers.get("chatgpt-account-id")).toBe(ACCOUNT_ID);
+			const metadata = request.headers.get("x-codex-turn-metadata");
+			expect(metadata).not.toBeNull();
+			expect(request.payload["client_metadata"]).toMatchObject({
+				"x-codex-window-id": request.headers.get("x-codex-window-id"),
+				"x-codex-turn-metadata": metadata,
+			});
+			expect(request.payload["tools"]).toEqual(
+				expect.arrayContaining([
+					expect.objectContaining({ type: "namespace", name: "history" }),
+					expect.objectContaining({ type: "namespace", name: "notes" }),
+				]),
+			);
+
+			const firstCompaction = await session.compact();
+			expect(firstCompaction.details).toMatchObject({ window: { windowNumber: 1 } });
+			await session.prompt("continue the same task in the next window");
+			await session.waitForIdle();
+			expect(requests).toHaveLength(2);
+			const secondRequest = requests[1];
+			if (!secondRequest) throw new Error("expected continuation after committed rollover");
+			expect(secondRequest.headers.get("x-codex-window-id")).not.toBe(request.headers.get("x-codex-window-id"));
+			const secondCompaction = await session.compact();
+			expect(secondCompaction.details).toMatchObject({ window: { windowNumber: 2 } });
+			expect(sessionManager.getEntries().filter((entry) => entry.type === "compaction")).toHaveLength(2);
+			expect(requests).toHaveLength(2); // Neither compaction may invoke a summary model.
+		} finally {
+			session?.dispose();
+			await rm(directory, { recursive: true, force: true });
+		}
+	},
+);
