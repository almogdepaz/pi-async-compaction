diff --git a/packages/coding-agent/src/core/context-handler-requirement.ts b/packages/coding-agent/src/core/context-handler-requirement.ts
new file mode 100644
index 000000000..30d0dc57c
--- /dev/null
+++ b/packages/coding-agent/src/core/context-handler-requirement.ts
@@ -0,0 +1,43 @@
+import type { SessionEntry } from "./session-manager.ts";
+
+export const REQUIRED_CONTEXT_HANDLER_ENTRY_TYPE = "pi.required-context-handler";
+
+export interface RequiredContextHandler {
+	readonly handler: string;
+	readonly version: number;
+}
+
+const HANDLER_ID_PATTERN = /^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$/;
+
+function parseRequirement(value: unknown): RequiredContextHandler {
+	if (!value || typeof value !== "object" || Array.isArray(value)) {
+		throw new Error("Malformed required context-handler state");
+	}
+	const record = value as Record<string, unknown>;
+	if (
+		record["protocol"] !== 1 ||
+		typeof record["handler"] !== "string" ||
+		!HANDLER_ID_PATTERN.test(record["handler"]) ||
+		!Number.isInteger(record["version"]) ||
+		(record["version"] as number) < 1
+	) {
+		throw new Error("Malformed required context-handler state");
+	}
+	return { handler: record["handler"], version: record["version"] as number };
+}
+
+/** Returns the single persisted context handler requirement, if the session has one. */
+export function getRequiredContextHandler(entries: readonly SessionEntry[]): RequiredContextHandler | undefined {
+	let requirement: RequiredContextHandler | undefined;
+	for (const entry of entries) {
+		if (entry.type !== "custom" || entry.customType !== REQUIRED_CONTEXT_HANDLER_ENTRY_TYPE) {
+			continue;
+		}
+		const parsed = parseRequirement(entry.data);
+		if (requirement && (requirement.handler !== parsed.handler || requirement.version !== parsed.version)) {
+			throw new Error("Conflicting required context-handler state");
+		}
+		requirement = parsed;
+	}
+	return requirement;
+}
