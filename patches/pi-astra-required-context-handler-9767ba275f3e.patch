+		const url = input instanceof Request ? input.url : String(input);
+		assert(url.startsWith("https://chatgpt.com/backend-api/codex/"), "unexpected offline request destination");
+		const body = init?.body;
+		assert(typeof body === "string" || body instanceof Uint8Array);
+		const payload: unknown = JSON.parse(typeof body === "string" ? body : zstdDecompressSync(body).toString("utf8"));
+		const request = { url, headers: new Headers(init?.headers), payload, signal: init?.signal };
+		requests.push(request);
+		return reply(request);
+	});
+	const credentials = new InMemoryCredentialStore();
+	const claims = Buffer.from(
+		JSON.stringify({ "https://api.openai.com/auth": { chatgpt_account_id: ACCOUNT_ID } }),
+	).toString("base64url");
+	await credentials.modify("openai-codex", async () => ({
+		type: "oauth",
+		access: `offline.${claims}.signature`,
+		refresh: "unused",
+		expires: Date.now() + 3_600_000,
+	}));
+	const runtime = await ModelRuntime.create({ credentials, modelsPath: null, refreshOnCreate: false });
+	const model = runtime
+		.getModels("openai-codex")
+		.find((candidate) => candidate.id === (options.modelId ?? "gpt-6-astra"));
+	assert(model, "missing pinned native Astra model");
+	const settingsManager = SettingsManager.inMemory({
+		transport: "sse",
+		compaction: { enabled: false, keepRecentTokens: 1 },
+		retry: { enabled: false, maxRetries: 0, baseDelayMs: 0 },
+	});
+	const conflictingHistoryPath = join(cwd, "conflicting-history.ts");
+	const foreignRecoveryToolsPath = join(cwd, "foreign-recovery-tools.ts");
+	if (options.conflictingHistory) {
+		await writeFile(
+			conflictingHistoryPath,
+			`import { Type } from "typebox";
+export default function(pi) {
+	pi.registerTool({
+		name: "history",
+		label: "history",
+		description: "conflicting history tool",
+		parameters: Type.Object({}),
+		execute() { return { content: [{ type: "text", text: "wrong owner" }] }; },
+	});
+}`,
+		);
+	}
+	if (options.foreignRecoveryTools) {
+		await writeFile(
+			foreignRecoveryToolsPath,
+			`import { Type } from "typebox";
+export default function(pi) {
+	for (const name of ["history", "notes", "new_context", "get_context_remaining"]) {
+		pi.registerTool({
+			name,
+			label: name,
+			description: "foreign recovery tool",
+			parameters: Type.Object({}),
+			execute() { return { content: [{ type: "text", text: "foreign owner" }] }; },
+		});
+	}
+}`,
+		);
+	}
+	const resourceLoader = new DefaultResourceLoader({
+		cwd,
+		agentDir: join(cwd, "agent"),
+		settingsManager,
+		extensionFactories,
+		additionalExtensionPaths: [
+			...(options.conflictingHistory ? [conflictingHistoryPath] : []),
+			...(options.foreignRecoveryTools ? [foreignRecoveryToolsPath] : []),
+			join(dirname(dirname(extensionPath)), "index.ts"),
+			extensionPath,
+		],
+		noExtensions: true,
+		noSkills: true,
+		noPromptTemplates: true,
+		noThemes: true,
+		noContextFiles: true,
+		systemPrompt: "Offline recovery lifecycle fixture.",
+		appendSystemPrompt: [],
+	});
+	await resourceLoader.reload();
+	if (!options.allowExtensionErrors) expect(resourceLoader.getExtensions().errors).toEqual([]);
+	const manager = options.sessionFile
+		? SessionManager.open(options.sessionFile, join(cwd, "sessions"), cwd)
+		: SessionManager.create(cwd, join(cwd, "sessions"));
+	const { session } = await createAgentSession({
+		cwd,
+		agentDir: join(cwd, "agent"),
+		model,
+		modelRuntime: runtime,
+		resourceLoader,
+		settingsManager,
+		sessionManager: manager,
+		thinkingLevel: "off",
+		noTools: "builtin",
